{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data including gamification stats and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "points": { "type": "integer" },
        "level": { "type": "integer" },
        "contributions": { "type": "integer" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isBanned": { "type": "boolean" }
      },
      "required": ["uid", "displayName", "email", "role", "points", "level", "contributions"]
    },
    "UserContribution": {
      "title": "UserContribution",
      "description": "A trash spot reported by a user, containing location and confirmation reviews.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["illegal-dumping", "missed-collection", "hazardous", "other"] },
        "location": { "type": "object" },
        "createdAt": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "resolved", "verified"] }
      },
      "required": ["id", "userId", "userName", "imageUrl", "description", "category", "location", "createdAt", "status"]
    },
    "PinConfirm": {
      "title": "PinConfirm",
      "description": "A validation review support or cleanup confirmation for a reported trash spot.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["confirm-cleaned", "suggest-action"] },
        "actionRecommended": { "type": "string" },
        "comment": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "userName", "type", "createdAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "A community post created by an Eco-Warrior with reactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "location": { "type": "string" },
        "likes": { "type": "integer" },
        "comments": { "type": "integer" },
        "verified": { "type": "boolean" },
        "timestamp": { "type": "integer" },
        "likedBy": { "type": "array" }
      },
      "required": ["id", "userName", "content", "likes", "comments", "verified", "timestamp"]
    },
    "SystemLog": {
      "title": "SystemLog",
      "description": "Auditable log of administrative and moderative acts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "user": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "integer" },
        "type": { "type": "string", "enum": ["auth", "moderation", "system", "user"] }
      },
      "required": ["id", "action", "user", "timestamp", "type"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user account progress, levels, and authorization levels."
    },
    "contributions/{contributionId}": {
      "schema": "UserContribution",
      "description": "Stores core pins reporting trash items and categories."
    },
    "contributions/{contributionId}/confirms/{confirmId}": {
      "schema": "PinConfirm",
      "description": "Stores validation records, comments, and recommendations attached to a specific contribution pin."
    },
    "community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Feed updates published by community members."
    },
    "system_logs/{logId}": {
      "schema": "SystemLog",
      "description": "Audit trail logging admin activities."
    }
  }
}
