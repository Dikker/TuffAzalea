rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'admin';
    }

    // Validate ID length and character constraints to prevent ID poisoning
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
        request.resource.data.role == 'user' &&
        request.resource.data.points == 0 &&
        request.resource.data.level == 1;
      
      // Updates can be done by self or system admins
      allow update: if isSignedIn() && (
        isOwner(userId) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Contributions Collection
    match /contributions/{contributionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        isValidId(contributionId) &&
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        // Allow other users to suggest actions or confirm cleanups (which updates confirms list / status)
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirms', 'status'])
      );
      
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Community Posts Collection
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId);
      allow update: if isSignedIn() && (
        // Allow updating likes stream, likedBy, or contents
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'likedBy', 'comments']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        isAdmin()
      );
    }

    // System Activity Logs Action Track
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isAdmin();
    }
  }
}
